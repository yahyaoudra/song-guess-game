# Public app URL used for sharing links, score-card branding, canonical tags, and social metadata.
# Set this to the final connected domain in production.
APP_URL="https://songguessgame.online"
VITE_APP_URL="https://songguessgame.online"
VITE_DOMAIN_NAME="songguessgame.online"
TRUST_PROXY="true"

# Hidden admin route. In production, set a non-obvious path and keep it out of public links.
ADMIN_ACCESS_PATH="/owner-panel-change-me"

# Real server-side admin authentication. These values are never bundled into browser JavaScript.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-long-random-password"
ADMIN_SESSION_SECRET="generate-at-least-32-random-characters"

# Optional file paths for persisted admin config and activity logs.
ADMIN_CONFIG_PATH="./data/admin-config.json"
ADMIN_ACTIVITY_PATH="./data/activity-log.json"

# Google integrations. These can also be edited in the authenticated back office.
GOOGLE_ANALYTICS_MEASUREMENT_ID="G-XXXXXXXXXX"
GOOGLE_ADSENSE_CLIENT="ca-pub-0000000000000000"
GOOGLE_SEARCH_CONSOLE_VERIFICATION=""

# Google reCAPTCHA v3 spam protection.
# Add songguessgame.online and localhost/127.0.0.1 as allowed domains in Google reCAPTCHA.
VITE_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE="0.5"

# Postgres user auth, daily free-play limit, payments, and entitlements.
DATABASE_URL="postgres://user:password@localhost:5432/song_guess"
DATABASE_SSL="false"

# Stripe one-time 7-day pass.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Optional Google login. Redirect URI:
# https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Spotify Web API catalog lookup for requested artist packs.
# Create a Spotify app and add its Web API credentials here.
# Dashboard redirect URI:
# https://your-domain.com/api/spotify/callback
# Local redirect URI:
# http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_AUTO_REFRESH_ENABLED="true"
SPOTIFY_ARTIST_ALBUM_LIMIT="20"

# MailerSend transactional email API, used by MailerLite for transactional sending.
# Create a verified sending domain in MailerSend, then add the API token and from address.
MAILERSEND_API_KEY=""
MAILERSEND_FROM_EMAIL="noreply@songguessgame.online"
MAILERSEND_FROM_NAME="Song Guess Game"
